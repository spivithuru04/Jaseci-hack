import from "@jac/runtime" { Link }

cl def:pub BuildWiseDashboard() -> JsxElement {
    has project_name: str = "New Sri Lankan home";
    has area: str = "1200";
    has budget: str = "18000000";
    has rate: str = "14500";
    has quality: str = "Standard";
    has unit: str = "sq ft";
    has description: str = "";
    has location: str = "";
    has saved: str = "";
    has filename: str = "";
    has preview: str = "";
    has error: str = "";
    def set_name(e: ChangeEvent) { project_name = e.target.value; }
    def set_area(e: ChangeEvent) { area = e.target.value; }
    def set_budget(e: ChangeEvent) { budget = e.target.value; }
    def set_rate(e: ChangeEvent) { rate = e.target.value; }
    def set_quality(e: ChangeEvent) { quality = e.target.value; }
    def set_unit(e: ChangeEvent) { unit = e.target.value; }
    def set_description(e: ChangeEvent) { description = e.target.value; }
    def set_location(e: ChangeEvent) { location = e.target.value; }
    def set_file(e: ChangeEvent) {
        filename = "Selected floor plan";
        preview = "";
        saved = "Floor plan selected. This demo does not inspect its file contents or extract geometry; enter verified area manually.";
    }
    a = float(area) if area else 0.0;
    b = float(budget) if budget else 0.0;
    r = float(rate) if rate else 0.0;
    total = a * r;
    sqm = a if unit == "sq m" else a * 0.092903;
    balance = b - total;
    return <div className="min-h-screen bg-muted/40"><header className="border-b bg-background"><div className="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6"><div><p className="font-semibold">BuildWise</p><p className="text-xs text-muted-foreground">Sri Lanka house planner</p></div><span className="rounded-full border px-2 py-1 text-xs text-muted-foreground">Local estimate mode</span></div></header>
        <main className="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-7 sm:px-6"><div className="flex flex-wrap items-end justify-between gap-4"><div><h1 className="text-2xl font-semibold tracking-tight">Project planning workspace</h1><p className="mt-1 text-sm text-muted-foreground">Description, selected plan, and editable inputs feed the preliminary estimate.</p></div></div>
        {saved and <p role="status" className="rounded-lg border bg-card px-4 py-3 text-sm">{saved}</p>}{error and <p role="alert" className="rounded-lg border border-destructive/40 bg-card px-4 py-3 text-sm text-destructive">{error}</p>}
        <section className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><article className="rounded-xl border bg-card p-5 shadow-sm"><p className="text-sm text-muted-foreground">Indicative planning total</p><p className="mt-2 text-2xl font-semibold tabular-nums">{f"LKR {total:.0f}"}</p><p className="mt-1 text-xs text-muted-foreground">Gross area × user-entered demo rate</p></article><article className="rounded-xl border bg-card p-5 shadow-sm"><p className="text-sm text-muted-foreground">Floor area</p><p className="mt-2 text-2xl font-semibold tabular-nums">{f"{sqm:.1f}"} m²</p></article><article className="rounded-xl border bg-card p-5 shadow-sm"><p className="text-sm text-muted-foreground">Budget position</p><p className="mt-2 text-2xl font-semibold tabular-nums">{f"LKR {balance:.0f}"}</p><p className="mt-1 text-xs text-muted-foreground">Budget less indicative total</p></article><article className="rounded-xl border bg-card p-5 shadow-sm"><p className="text-sm text-muted-foreground">Specification</p><p className="mt-2 text-2xl font-semibold">{quality}</p></article></section>
        <div className="grid gap-6 xl:grid-cols-5"><section className="rounded-xl border bg-card shadow-sm xl:col-span-3"><header className="flex flex-col gap-1 p-6"><h2 className="text-lg font-semibold">Project details</h2><p className="text-sm text-muted-foreground">Inputs are used by the local deterministic estimator.</p></header><div className="flex flex-col gap-5 px-6 pb-6"><label className="flex flex-col gap-2 text-sm font-medium">Project name<input value={project_name} onChange={set_name} className="h-9 rounded-md border bg-background px-3 font-normal" /></label><label className="flex flex-col gap-2 text-sm font-medium">House description<textarea value={description} onChange={set_description} placeholder="Rooms, priorities, dimensions from your drawing" className="min-h-24 rounded-md border bg-background px-3 py-2 font-normal" /></label><label className="flex flex-col gap-2 text-sm font-medium">Construction city or district<input value={location} onChange={set_location} placeholder="Optional" className="h-9 rounded-md border bg-background px-3 font-normal" /></label><div className="grid gap-4 sm:grid-cols-2"><label className="flex flex-col gap-2 text-sm font-medium">Gross floor area<input type="number" min="0" value={area} onChange={set_area} className="h-9 rounded-md border bg-background px-3 font-normal" /></label><label className="flex flex-col gap-2 text-sm font-medium">Area units<select value={unit} onChange={set_unit} className="h-9 rounded-md border bg-background px-3 font-normal"><option>sq ft</option><option>sq m</option></select></label><label className="flex flex-col gap-2 text-sm font-medium">Target budget (LKR)<input type="number" min="0" value={budget} onChange={set_budget} className="h-9 rounded-md border bg-background px-3 font-normal" /></label><label className="flex flex-col gap-2 text-sm font-medium">Specification tier<select value={quality} onChange={set_quality} className="h-9 rounded-md border bg-background px-3 font-normal"><option>Economy</option><option>Standard</option><option>Premium</option></select></label></div>
        <div className="rounded-lg border bg-muted/30 p-4"><p className="mb-3 font-medium">2D floor plan</p><label htmlFor="plan" className="flex cursor-pointer flex-col items-center gap-2 rounded-lg border border-dashed bg-background px-4 py-6 text-center"><span className="text-sm font-medium">Choose PDF, PNG, or JPG</span><span className="text-xs text-muted-foreground">Plan file is selected locally; no geometry or dimensions are extracted by this app.</span><input id="plan" type="file" accept="application/pdf,image/png,image/jpeg" onChange={set_file} className="sr-only" /></label>{filename and <div className="mt-3 rounded-md bg-background p-3 text-sm"><p>{filename}</p>{preview and <img src={preview} alt="Selected floor plan" className="mt-3 max-h-80 w-full rounded border object-contain" />}{not preview and <p className="mt-2 text-xs text-muted-foreground">PDF selected for reference only. Enter verified floor area manually.</p>}</div>}</div>
        <p className="rounded-lg border border-dashed p-4 text-sm text-muted-foreground">Measurement provenance: manually entered floor area. Room layout, wall lengths, openings, and structural design are not available as editable geometry in this application.</p><Link to={"/estimate?area=" + area + "&unit=" + ("sqm" if unit == "sq m" else "sqft") + "&rate=" + rate + "&budget=" + budget + "&quality=" + quality + "&location=" + location + "&project=" + project_name} className="w-fit rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground shadow-sm">Analyze & Estimate</Link></div></section>
        <div className="flex flex-col gap-6 xl:col-span-2"><section className="rounded-xl border bg-card shadow-sm"><header className="flex flex-col gap-1 p-6"><h2 className="text-lg font-semibold">Local cost formula</h2><p className="text-sm text-muted-foreground">Area × editable illustrative rate</p></header><div className="flex flex-col gap-4 px-6 pb-6"><label className="flex flex-col gap-2 text-sm font-medium">Demonstration rate per {unit} (LKR)<input type="number" min="0" value={rate} onChange={set_rate} className="h-9 rounded-md border bg-background px-3 font-normal" /></label><div className="flex justify-between border-t pt-4 text-sm"><span>Calculated subtotal</span><strong className="tabular-nums">{f"LKR {total:.0f}"}</strong></div><p className="rounded-md border p-3 text-xs leading-relaxed text-muted-foreground">This rate is user editable and is not verified current market data, a BSR rate, or a supplier quote. AI is not used for quantities or prices.</p></div></section><section className="rounded-xl border bg-card p-5 shadow-sm"><h2 className="font-semibold">Low-cost AI mode</h2><p className="mt-2 text-sm text-muted-foreground">Description interpretation is optional and separate from estimation. The current estimation button works without an API key; calculations use only entered floor area and rate.</p><p className="mt-2 text-xs text-muted-foreground">Plan uploads are not sent to an AI model and are not interpreted.</p></section><section className="rounded-xl border border-dashed bg-card p-5"><p className="font-medium">Materials and labor rates</p><p className="mt-1 text-sm text-muted-foreground">Material prices entered in the manager are browser-local and unavailable to this estimate service. Labor costs remain unavailable until worker rates and work quantities are defined.</p></section></div></div><footer className="border-t pt-4 text-xs text-muted-foreground">Preliminary planning estimate only. Not a certified BOQ.</footer></main></div>;
}

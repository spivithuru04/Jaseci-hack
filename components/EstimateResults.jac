import from "@jac/runtime" { Link, useLocation }

cl def:pub EstimateResults() -> JsxElement {
    location_state = useLocation();
    # jac:ignore[E1053]
    search: any = new(URLSearchParams, location_state.search);
    area = float(search.get("area") or "0");
    rate = float(search.get("rate") or "0");
    budget = float(search.get("budget") or "0");
    unit_code = search.get("unit") or "sqft";
    quality = search.get("quality") or "Unknown";
    location = search.get("location") or "Not provided";
    project_name = search.get("project") or "Project estimate";
    area_sqft = area if unit_code == "sqft" else area * 10.7639104167;
    area_sqm = area if unit_code == "sqm" else area * 0.092903;
    total = area * rate;
    cost_per_sqft = total / area_sqft if area_sqft > 0.0 else 0.0;
    balance = budget - total;
    has_result = area > 0.0 and rate >= 0.0;
    return <main className="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-7 sm:px-6"><header className="flex flex-wrap items-end justify-between gap-4"><div><p className="text-sm font-medium text-primary">BuildWise · Preliminary estimate</p><h1 className="mt-1 text-2xl font-semibold tracking-tight">Construction estimation dashboard</h1><p className="mt-1 text-sm text-muted-foreground">Local formula using the submitted area and user-entered demo rate only.</p></div><Link to="/" className="rounded-md border bg-background px-4 py-2 text-sm">Back to project</Link></header>
        {not has_result and <section className="rounded-xl border bg-card p-6 text-sm text-muted-foreground">No usable estimate parameters were provided. Return to the project and choose Analyze & Estimate.</section>}
        {has_result and <div className="flex flex-col gap-6"><section className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><article className="rounded-xl border bg-card p-5 shadow-sm"><p className="text-sm text-muted-foreground">Planning total</p><p className="mt-2 text-2xl font-semibold tabular-nums">{f"LKR {total:.0f}"}</p><p className="mt-1 text-xs text-muted-foreground">Illustrative, not a quote</p></article><article className="rounded-xl border bg-card p-5 shadow-sm"><p className="text-sm text-muted-foreground">Gross floor area</p><p className="mt-2 text-2xl font-semibold tabular-nums">{f"{area_sqm:.1f}"} m²</p><p className="mt-1 text-xs text-muted-foreground">{f"{area_sqft:.0f}"} sq ft</p></article><article className="rounded-xl border bg-card p-5 shadow-sm"><p className="text-sm text-muted-foreground">Derived cost per sq ft</p><p className="mt-2 text-2xl font-semibold tabular-nums">{f"LKR {cost_per_sqft:.0f}"}</p></article><article className="rounded-xl border bg-card p-5 shadow-sm"><p className="text-sm text-muted-foreground">Budget balance</p><p className="mt-2 text-2xl font-semibold tabular-nums">{f"LKR {balance:.0f}"}</p><p className="mt-1 text-xs text-muted-foreground">Budget less planning total</p></article></section>
        <div className="grid gap-6 xl:grid-cols-3"><section className="rounded-xl border bg-card p-6 shadow-sm xl:col-span-2"><h2 className="text-lg font-semibold">Project inputs</h2><dl className="mt-4 grid gap-4 sm:grid-cols-2"><div><dt className="text-xs text-muted-foreground">Project</dt><dd className="mt-1 font-medium">{project_name}</dd></div><div><dt className="text-xs text-muted-foreground">Location</dt><dd className="mt-1 font-medium">{location}</dd></div><div><dt className="text-xs text-muted-foreground">Specification</dt><dd className="mt-1 font-medium">{quality}</dd></div><div><dt className="text-xs text-muted-foreground">Target budget</dt><dd className="mt-1 font-medium tabular-nums">{f"LKR {budget:.0f}"}</dd></div><div><dt className="text-xs text-muted-foreground">Rate basis</dt><dd className="mt-1 text-sm">{f"LKR {rate:.0f} / {unit_code}"}</dd></div></dl></section><section className="rounded-xl border border-dashed bg-card p-6"><h2 className="text-lg font-semibold">Estimate source</h2><p className="mt-2 text-sm text-muted-foreground">User-entered demonstration rate, multiplied by floor area.</p><p className="mt-2 text-sm text-muted-foreground">The uploaded plan filename and contents are not parsed or measured. No room count, wall, door, window, or roof geometry was calculated.</p></section></div>
        <section className="rounded-xl border bg-card p-6 shadow-sm"><h2 className="text-lg font-semibold">Cost breakdown availability</h2><div className="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><div className="rounded-lg border p-4"><p className="text-xs text-muted-foreground">Materials</p><p className="mt-1 font-medium">Price not available</p></div><div className="rounded-lg border p-4"><p className="text-xs text-muted-foreground">Labor</p><p className="mt-1 font-medium">Rate and crew-days unavailable</p></div><div className="rounded-lg border p-4"><p className="text-xs text-muted-foreground">Transportation</p><p className="mt-1 font-medium">Not estimated</p></div><div className="rounded-lg border p-4"><p className="text-xs text-muted-foreground">Contingency</p><p className="mt-1 font-medium">Not included</p></div></div><p className="mt-4 rounded-md border p-3 text-sm text-muted-foreground">No certified BOQ, precise structural quantities, or professional approval is generated. Material prices are stored in browser-local storage and are not connected to this page.</p></section></div>}
    </main>;
}
